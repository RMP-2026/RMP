{
  "name": "@rmp/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../apps/mobile/.env.local -- drizzle-kit generate",
    "db:push": "dotenv -e ../../apps/mobile/.env.local -- drizzle-kit push",
    "db:studio": "dotenv -e ../../apps/mobile/.env.local -- drizzle-kit studio",
    "db:apply-extensions": "dotenv -e ../../apps/mobile/.env.local -- tsx src/apply-extensions-and-constraints.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
